
# Xcode user state
**/xcuserdata/
**/*.xcuserstate

# macOS Finder metadata
**/.DS_Store

# API key config (contains secrets)
Nova/Config.plist

# Claude session data
.claude/

# Python backend — bytecode and virtualenvs
nova_backend/__pycache__/
**/__pycache__/
*.pyc
nova_backend/.venv/
nova_backend/venv/

# Local model weights — copied in per-machine, never version-controlled
# (Kokoro TTS files live in nova_backend/, same files as Jarvis)
nova_backend/kokoro-v1.0.onnx
nova_backend/voices-v1.0.bin
*.onnx
*.bin
# Exception: the trained wake model is small (~790KB) and worth version-controlling
# as a backup of a ~2hr Colab training run.
!nova_backend/nova.onnx

# Test bytecode
nova_backend/tests/__pycache__/
